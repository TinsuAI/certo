# Example CO -> Data Hub link settings.
# Copy values into your local shell or ignored .env file and replace secrets.

# Optional UI/local override file. Default is data/local/runtime/data-hub-link.json.
DATA_HUB_CONFIG_PATH=data/local/runtime/data-hub-link.json

DATA_HUB_ENABLED=1
CO_AUTH_REQUIRED=1

# Browser-facing Data Hub URL used for login/authorize redirects.
DATA_HUB_BASE_URL=http://127.0.0.1:8754

# Server-to-server Data Hub API URL. Defaults to DATA_HUB_BASE_URL when unset.
DATA_HUB_API_BASE_URL=http://127.0.0.1:8754

# JWT verification. Local Data Hub defaults to issuer http://localhost:8754.
DATA_HUB_ISSUER_URL=http://localhost:8754
DATA_HUB_JWKS_URL=http://127.0.0.1:8754/v1/auth/jwks

# Optional fallback service token for Data Hub reads when no user token is available.
# Leave blank when the target Data Hub has API auth disabled.
DATA_HUB_SERVICE_TOKEN=

# Browser-facing CO URL Data Hub redirects back to after SSO.
CO_PUBLIC_BASE_URL=http://127.0.0.1:8001
CO_FORCE_HTTPS_COOKIE=0

DATA_HUB_REQUEST_TIMEOUT_SECONDS=20

# JWT claim keys used to map a Data Hub user to CO/Data Hub client IDs.
DATA_HUB_CLIENT_CLAIM_KEYS=client_ids,clients,allowed_clients,visible_clients,dncx_ids,client_id,dncx_id
DATA_HUB_ADMIN_ROLES=dev,admin
