# Data Hub environment template.
# Install at /etc/data-hub/.env with mode 0440, owner root:hub.

# Postgres connection. Use a dedicated `hub_app` role with DDL+DML on
# the hub schema. Sister apps (BCQT/CO) get READ-ONLY roles on hub.*.
DATABASE_URL=postgresql://hub_app:CHANGE_ME@localhost/data_hub

# Seed admin user — created on first boot if no users exist. Rotate
# password via /admin after first login.
DATA_HUB_SEED_EMAIL=admin@example.com
DATA_HUB_SEED_PASSWORD=CHANGE_ME

# Auto-seed demo data (Growatt VN + Johnson VN sample clients). 0 in
# production — operator creates real clients via UI.
DATA_HUB_AUTO_SEED_DEMO=0

# JWT issuer key directory. Ed25519 keypairs live here; private keys
# 0400 root:hub. Rotation: drop new keypair → wait for JWKS cache to
# refresh in consumers (10 min) → flip sso_active_kid via
# /admin/settings/technical.
DATA_HUB_KEYS_DIR=/etc/data-hub/keys

# File uploads root. Content-addressed, sha256-named. Phase 2 swaps
# to S3-compatible (Cloudflare R2, MinIO).
DATA_HUB_FILES_ROOT=/var/lib/data-hub/files

# Optional: real-data corpus path for env-gated tests. Leave unset in
# production.
# DATA_HUB_REAL_DATA_DIR=/tmp/dh_real_data

# Server tuning (uvicorn args, override systemd unit if needed).
# Default reflected in deploy/systemd/data-hub.service.
