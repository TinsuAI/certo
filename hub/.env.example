# Copy to .env on the server. Do NOT commit the filled-in version.

# Postgres (lives inside the compose network as service `db`)
POSTGRES_USER=hub
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=data_hub

# Admin seeded on first boot if no user exists. Change after first login.
DATA_HUB_SEED_EMAIL=admin@data-hub.local
DATA_HUB_SEED_PASSWORD=replace_with_strong_password

# Bind interface for the app port. Defaults to 0.0.0.0 (all interfaces,
# including Tailscale). Set to 127.0.0.1 if you put nginx in front.
# APP_BIND=0.0.0.0

# API auth kill switch. 1 = skip bearer check on /v1/hub/* (demo only).
# Suppressed automatically when api_auth_strict=true is set in DB.
# DATA_HUB_API_AUTH_DISABLED=0

# SSO cross-domain (set when serving over HTTPS behind a public domain
# and consumer apps live on a different origin, e.g. CO at
# https://barry-co.tinsu.ai). Comma-separated list of allowed return
# origins for the post-login redirect.
# DATA_HUB_SSO_ALLOWED_REDIRECT_ORIGINS=https://barry-co.example.com

# Set to 1 when the app is reached over HTTPS (Cloudflare tunnel,
# nginx TLS, etc.). Forces Secure flag on session cookies.
# DATA_HUB_FORCE_HTTPS_COOKIE=0
