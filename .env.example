# Copy to .env on the server. Do NOT commit the filled-in version.

# App port. Data Hub uses 8754 on the same demo server; CO uses 8755.
APP_BIND=0.0.0.0
APP_PORT=8755

# Postgres for CO-owned state. Data Hub master data remains in Data Hub.
POSTGRES_USER=co
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=barry_co
BARRY_DATABASE_SCHEMA=co

# CO browser URL used by Data Hub SSO redirects.
CO_PUBLIC_BASE_URL=http://<private-host>:8755
CO_FORCE_HTTPS_COOKIE=0

# Data Hub demo link. Use the root URL only; CO appends /v1/hub paths.
DATA_HUB_ENABLED=1
# When DATA_HUB_ENABLED is off, CO refuses to serve source data (503) rather than
# silently falling back to the local file-store backup. Set to 1 ONLY for offline
# dev/tests to allow the local file-store backend.
CO_ALLOW_LOCAL_SOURCE=0
CO_AUTH_REQUIRED=1
DATA_HUB_BASE_URL=http://<private-host>:8754
DATA_HUB_API_BASE_URL=http://<private-host>:8754
DATA_HUB_ISSUER_URL=http://<private-host>:8754
DATA_HUB_JWKS_URL=http://<private-host>:8754/v1/auth/jwks

# Optional. Leave blank when the target Data Hub has API auth disabled.
DATA_HUB_API_TOKEN=
DATA_HUB_REQUEST_TIMEOUT_SECONDS=20
DATA_HUB_CLIENT_CLAIM_KEYS=client_ids,clients,allowed_clients,visible_clients,dncx_ids,client_id,dncx_id
DATA_HUB_ADMIN_ROLES=dev,admin

# Reserved for CO LLM settings if/when CO adds LLM-backed behavior.
LLM_BASE_URL=https://codex-lb-demo.sgnai.dev/v1
LLM_MODEL=gpt-5.5
LLM_API_KEY=replace_with_non_empty_demo_key
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_MAX_CALLS_PER_DAY_PER_CLIENT=50
