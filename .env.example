# Copy to .env on the server. Do NOT commit the filled-in version.

# Postgres (lives inside the compose network as service `db`)
POSTGRES_USER=hub
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=data_hub

# Admin seeded on first boot if no user exists. Change after first login.
DATA_HUB_SEED_EMAIL=admin@data-hub.local
DATA_HUB_SEED_PASSWORD=replace_with_strong_password

# Bind interface for the app port. Defaults to 0.0.0.0 (all interfaces,
# including Tailscale). Set to 127.0.0.1 if you put nginx in front.
# APP_BIND=0.0.0.0
