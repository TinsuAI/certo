# Data Hub cron schedule (Compose deploy). Install at
# /etc/cron.d/data-hub (root-owned). Runs as the host user that owns
# the Compose project (`tinsu` on the demo host).
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=ops@example.com

# Daily Postgres dump @ 02:30 (low-traffic window).
30 2 * * * tinsu /usr/local/bin/backup-postgres.sh >> /var/log/data-hub/backup.log 2>&1

# Hourly purge of expired upload_pending rows (safety-net; lifespan
# task already does this, but cron catches the case where the app was
# restarted within the hour).
17 * * * * tinsu cd /home/tinsu/data-hub && docker compose exec -T db psql -U hub -d data_hub -c "select hub.purge_expired_pending_uploads();" > /dev/null 2>&1
